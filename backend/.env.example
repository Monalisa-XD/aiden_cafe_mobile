# Secret used to sign JSON Web Tokens (generate a secure random 64-char string)
JWT_SECRET=your-long-random-secret-here
PORT=5000

# Comma-separated list of allowed CORS origins for production
ALLOWED_ORIGINS=http://localhost:5000,http://localhost:3000

# Optional MySQL Configuration (leave commented to use SQLite)
# MYSQL_HOST=localhost
# MYSQL_USER=root
# MYSQL_PASSWORD=
# MYSQL_DATABASE=aiden_cafe
# MYSQL_PORT=3306
# MYSQL_SSL=false
